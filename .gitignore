# What never leaves this machine.
#
# Rewritten 2026-08-22 (machinery rebuild). Rules were RETAINED unless proved
# dead, not dropped for being quiet: a rule whose artifact is absent here may
# still be protecting a file in someone else's clone, and removing it exposes
# that file on their next `git add -A`. Entries kept for that reason are marked
# LEGACY, with what produced them.
#
# A dead ignore rule is silent, so it survives. On 2026-08-21 this file named
# nineteen skills the rebuild had already deleted. Add a line when you install
# something; delete it when you remove it.

# --- credentials, and anything that can carry one -------------------------
# settings.json holds live API keys under `env`. The globs matter as much as
# the name: a one-off backup (settings.json.pre-hookfix.bak) once slipped past
# exact-name entries and would have been committed with live keys.
settings.json
settings.json*.bak
settings.json.*
settings.local.json
*.local.json
.credentials.json

# The harness leaves these behind when a write to ~/.claude.json is
# interrupted. They carry mcpServers blocks with live tokens; two were found
# untracked and UNIGNORED on 2026-08-02, one of them 70KB. A single
# `git add -A` would have published them.
.claude.json
.claude.json.tmp.*
*.json.tmp.*

# Company names and private hostnames, read by hooks/pre-commit rule 4.
# The tracked template beside it is .no-yolo-deny.example.txt.
.no-yolo-deny.txt

# --- things that name the owner -------------------------------------------
# The index lists every fact remembered, so publishing it publishes the list
# even when the fact bodies stay behind. hooks/pre-commit blocks both by path
# as well, because .gitignore stops an ordinary `git add` and nothing else.
# The tracked template is memory/MEMORY.example.md.
memory/MEMORY.md
memory/facts/
# LEGACY: the deleted memory compiler
memory/compile-manifest.json
learnings.md

# --- work in progress, and session state ----------------------------------
# Handoffs and plans quote conversation detail that was never meant to travel.
handoffs/
plans/
advisor-plans/
proposals/
brainstorms/
tasks/
.pending-tasks.md
# LEGACY: Codex round transcripts
.xcheck/
# LEGACY
.pending-audit-*.md
# LEGACY
.audit-*-detail/
.mockups/
# LEGACY: sketches belonging to another repo
mockup-archive/

# --- runtime state the harness writes -------------------------------------
projects/
sessions/
session-data/
session-env/
shell-snapshots/
file-history/
history.jsonl
ide/
metrics/
# The harness's background daemon and its work queue, found untracked on 2026-08-28
# while releasing. daemon/control.key is a live credential and jobs/ holds session
# transcripts, so a single `git add -A` would publish both.
daemon/
daemon.lock
daemon.status.json
daemon.json
daemon.log
jobs/
# Where the Playwright MCP server drops console logs, page snapshots and
# screenshots. Output, not configuration: the server itself is configured in
# settings.json, which is ignored above. Six files, 320K, were found untracked
# here on 2026-08-27 and removed by hand.
.playwright-mcp/
chrome/
debug/
.claude/
*.log

# Mode markers. Existence IS the state; contents are never read.
.literal-active
# LEGACY: the deleted lockstep guard
.lockstep-active
.eli5-active
.worktree-active/
.last-cleanup
.last-update-result.json
# LEGACY
.learnings-turn-counter
# LEGACY
.reflect-turn-counter
mcp-health-cache.json
mcp-needs-auth-cache.json
policy-limits.json
remote-settings.json

# --- caches, rebuilt not restored -----------------------------------------
cache/
paste-cache/
image-cache/
__pycache__/
*.pyc

# --- other people's code --------------------------------------------------
plugins/
.agents/
# ...but not a copy of one sitting inside archive/. `.agents/` above is a LIVE install path;
# `archive/styleseed/.agents/` is a hash-verified snapshot taken before a delete, and the
# whole point of taking it was that those paths were never in git and could not otherwise be
# restored. Ignoring the snapshot would have left half the archive on one laptop: 52 of its
# 104 files, including the 372 KB engine the router depends on. Found by checking `git
# status --ignored` before committing, not after.
!archive/styleseed/.agents/
!archive/styleseed/.agents/**
# `npx skills` installs land in .agents/ and are symlinked into skills/ so they
# load in every project. Those symlinks are local install state, not content.
# StyleSeed's 23 entries left this list on 2026-08-25. They are in archive/styleseed/,
# copied and hash-verified before removal, with archive/MANIFEST.md holding the restore
# command. They were never in git, so archiving was the only way the removal could be undone.
skills/avoid-ai-writing
skills/writing-for-agents
skills/codebase-design
skills/domain-modeling
skills/mcp-builder
skills/systematic-debugging
# Arrived here on 2026-08-22 from ~/.agents/skills, moved by `npx skills update`.
# An update can relocate a skill, so a new untracked directory under skills/ is
# expected after one; check `git status` before staging.
skills/orca-cli
skills/archify
skills/resolving-merge-conflicts
# The /design skill returned on 2026-08-25 and its material is TRACKED this time, in
# refs/brands/. The old gitignored vendor path is what let 74 brand specifications vanish
# without anyone noticing. Nothing under skills/design/ is ignored now.
# LEGACY: scraped third-party design specs
refs/design-specs/

# --- archives and backups -------------------------------------------------
_archive_*/
backups/
.skill-trash/
skills/*/_claude_bak/
# LEGACY: the removed setup.sh --md-only flag
CLAUDE.md.pre-md-only

# verify-selftest.sh's single-run lock. A dead one is removed with rmdir, and it
# must never be committed: a checked-in lock would refuse every run everywhere.
.selftest.lock/

# --- OS -------------------------------------------------------------------
.DS_Store

# Local state for hooks/upstream-watch.sh: the daily stamp, the last seen Claude Code
# version, and any report waiting to be shown. Machine state, never content.
.upstream/
