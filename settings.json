{
  "permissions": {
    "defaultMode": "auto"
  },
  "skillOverrides": {},
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "LOG=\"$HOME/.claude/reap-codex-orphans.log\"; { date -u '+== %Y-%m-%dT%H:%M:%SZ'; \"$HOME/AI/no-yolo/scripts/reap-codex-orphans.sh\"; } >>\"$LOG\" 2>&1 || echo \"reap-codex-orphans failed; see $LOG\" >&2",
            "timeout": 120,
            "statusMessage": "Reaping orphaned Codex brokers",
            "async": true
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh",
    "padding": 0
  },
  "enabledPlugins": {
    "codex@openai-codex": true
  },
  "outputStyle": "Plain",
  "modelSettings": {
    "claude-opus-5": {
      "effortLevel": "medium"
    }
  },
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark",
  "inputNeededNotifEnabled": false,
  "agentPushNotifEnabled": true
}
