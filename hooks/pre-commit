#!/usr/bin/env bash
# Pre-commit hook for ~/.claude (holland-built/no-yolo) — TRACKED SOURCE.
# Installed into .git/hooks/pre-commit by setup.sh. Blocks commits containing
# personal data, private-network/infra values, and terms from .no-yolo-deny.txt.

# Credential / personal patterns
# The first six rules need a giveaway WORD next to the value (password=, secret:,
# api_key=). A real token carries no such word, so a bare ghp_… or sk-ant-… pasted
# into a doc matched nothing here for months — only AKIA… was a real token FORMAT.
# The rules after AKIA are vendor-assigned prefixes with fixed lengths: they name
# themselves, so they catch a pasted key with no context and effectively cannot
# false-positive on prose. Borrowed from Trivy's secret ruleset, not the tool —
# this repo has no dependencies, so Trivy's real job would scan nothing here.
# Mirrored by verify.sh CRED_SCAN — if this changes, mirror it there. Both are
# positive-controlled against hooks/tests/infra-scan-probe.txt (verify.sh 8a/8b).
PATTERNS="/Users/[a-zA-Z0-9_-]+|session: [a-f0-9-]{36}|password\s*[:=]|secret\s*[:=]|api[_-]?key\s*[:=]|AKIA[0-9A-Z]{16}|gh[opsru]_[A-Za-z0-9]{36}|github_pat_[A-Za-z0-9_]{22,}|sk-ant-[A-Za-z0-9_-]{20,}|sk-proj-[A-Za-z0-9_-]{20,}|xox[abprs]-[A-Za-z0-9-]{10,}|AIza[0-9A-Za-z_-]{35}|sk_live_[0-9A-Za-z]{20,}|glpat-[A-Za-z0-9_-]{20}|npm_[A-Za-z0-9]{36}|-----BEGIN [A-Z ]*PRIVATE KEY-----|aws_secret_access_key[[:space:]]*[:=]|postgres://[^@[:space:]<>]+@|mysql://[^@[:space:]<>]+@|mongodb\+srv://[^@[:space:]<>]+@|redis://:[^@[:space:]<>]+@|[Bb]earer [A-Za-z0-9._-]{20,}|eyJ[A-Za-z0-9_-]{10,}\.eyJ[A-Za-z0-9_-]{10,}\.|SG\.[0-9A-Za-z_-]{22}\.[0-9A-Za-z_-]{43}|rk_live_[0-9A-Za-z]{24,}|sk-[a-zA-Z0-9]{20,}"

# Private-network / internal-infra patterns — these leaked once (a self-hosted
# LAN IP, a tailnet host) and the credential patterns above didn't catch them.
# Docs must use placeholders (<your-host>, <port>), never real private values.
#   RFC1918 LAN IPs (192.168/16, 10/8, 172.16-31)
#   Tailscale CGNAT range (100.64/10)
#   Internal-only hostname TLDs (.internal .corp .lan .home + *.local hostnames)
# Mirrored by verify.sh check 8 (tracked-content scan) — if this changes, mirror it there.
INFRA_PATTERNS="192\.168\.[0-9]{1,3}\.[0-9]{1,3}|(^|[^0-9])10\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}|172\.(1[6-9]|2[0-9]|3[01])\.[0-9]{1,3}\.[0-9]{1,3}|100\.(6[4-9]|[7-9][0-9]|1[0-1][0-9]|12[0-7])\.[0-9]{1,3}\.[0-9]{1,3}|[a-z0-9-]+\.(internal|corp|lan|home)\b|[a-z0-9-]+\.[a-z0-9-]+\.local\b"

BLOCKED_FILES=(
  "memory/facts/"
  "memory/compile-manifest.json"
  "brainstorms/"
  "plans/"
  "proposals/"
  "settings.json"
  "settings.local.json"
  "history.jsonl"
  "projects/"
  "sessions/"
  "cache/"
  "paste-cache/"
)

echo "🔍 no-yolo pre-commit: scanning for personal data..."

# 1 — Block personal dirs (only additions/modifications — allow deletions)
STAGED_AM=$(git diff --cached --name-status | grep -E "^[AM]" | awk '{print $2}')
for pattern in "${BLOCKED_FILES[@]}"; do
  if echo "$STAGED_AM" | grep -q "^$pattern"; then
    echo "❌ BLOCKED: personal path being added/modified: $pattern"
    echo "   Run: git reset HEAD <file> to unstage"
    exit 1
  fi
done

# The two probe fixtures are excluded from the infra scan below, by name, because
# their whole purpose is to hold the values it blocks: they are the controls
# that prove this pattern can still match (verify.sh checks 8a/8b). Without this
# exclusion the hook refuses every commit that touches them — it did, which is how
# they came to be separate files instead of inline test data.
#
# They are the ONE place in this repo a real leak could hide, so verify.sh pins both
# by sha256 and fails if either changes without the hash being updated. Keep this
# list and verify.sh's SCAN_EXCLUDE in step.
# added lines only, minus lines that are themselves regex patterns
ADDED=$(git diff --cached | grep -E "^\+" | grep -vE "^\+\+\+" | grep -v "\[a-zA-Z" | grep -v "\[a-z0-9")

# The same, with the probe fixtures' hunks removed, for the infra scan only. Done
# per-file via --cached -- :!path so a probe line cannot be attributed to another
# file's diff.
ADDED_NOPROBE=$(git diff --cached -- . ":!hooks/tests/infra-scan-probe.txt" ":!hooks/tests/infra-scan-clean.txt" \
  | grep -E "^\+" | grep -vE "^\+\+\+" | grep -v "\[a-zA-Z" | grep -v "\[a-z0-9")

# The same again, minus every file that legitimately CONTAINS credential formats:
# the two pinned probe fixtures, plus the four files that document the patterns
# themselves (this hook, verify.sh, the health skill, the deny-list example).
# This list mirrors verify.sh's SCAN_EXCLUDE — change one, change the other.
# The fixtures are sha256-pinned by verify.sh, so excluding them hides nothing.
ADDED_CRED=$(git diff --cached -- . ":!hooks/pre-commit" ":!verify.sh" ":!skills/health/SKILL.md" \
  ":!.no-yolo-deny.example.txt" ":!hooks/tests/infra-scan-probe.txt" ":!hooks/tests/infra-scan-clean.txt" \
  | grep -E "^\+" | grep -vE "^\+\+\+" | grep -v "\[a-zA-Z" | grep -v "\[a-z0-9")

# 2 — Block personal / credential content
MATCHES=$(echo "$ADDED_CRED" | grep -E "$PATTERNS")
if [ -n "$MATCHES" ]; then
  echo "❌ BLOCKED: personal data pattern found in diff:"
  echo "$MATCHES"
  echo ""
  echo "Fix the content above, then re-stage and commit."
  exit 1
fi

# 3 — Block private-network / internal-infra values (use placeholders in docs)
INFRA=$(echo "$ADDED_NOPROBE" | grep -EI "$INFRA_PATTERNS")
if [ -n "$INFRA" ]; then
  echo "❌ BLOCKED: private network / internal infra value in diff:"
  echo "$INFRA"
  echo ""
  echo "Docs must use placeholders (<your-host>, <port>) — never real LAN IPs,"
  echo "tailnet addresses, or internal hostnames. Fix, re-stage, commit."
  exit 1
fi

# 4 — Block company / private terms from the local (gitignored) deny-list
DENY_FILE="$(git rev-parse --show-toplevel)/.no-yolo-deny.txt"
if [ -f "$DENY_FILE" ]; then
  TERMS=$(grep -vE '^\s*#|^\s*$' "$DENY_FILE" | paste -sd'|' -)
  if [ -n "$TERMS" ]; then
    DENIED=$(echo "$ADDED" | grep -iE "$TERMS")
    if [ -n "$DENIED" ]; then
      echo "❌ BLOCKED: term from .no-yolo-deny.txt (company/private) in diff:"
      echo "$DENIED"
      echo ""
      echo "These must never be published. Fix, re-stage, commit."
      echo "(Edit ~/.claude/.no-yolo-deny.txt to adjust the list.)"
      exit 1
    fi
  fi
fi

echo "✅ no-yolo pre-commit: clean"
exit 0
