#!/bin/sh
# Block a commit that contains a secret. Set globally via core.hooksPath, so
# every repo on this machine gets it and no project carries its own copy.
# Skip deliberately with: git commit --no-verify
command -v gitleaks >/dev/null 2>&1 || exit 0
gitleaks git --staged --redact --no-banner . || {
  echo ""
  echo "Commit blocked: gitleaks found a secret in what you staged."
  echo "Take the value out, put it in .env (ignored), commit again."
  exit 1
}
