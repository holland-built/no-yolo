#!/usr/bin/env bash
# Refuses a commit that would publish something private. TRACKED SOURCE:
# setup.sh copies this into .git/hooks/pre-commit, and verify.sh check 8c fails
# when the installed copy has drifted from this one.
#
# Rewritten from a blank page 2026-08-22 (machinery rebuild). The contract is
# hooks/tests/pre-commit.test.sh, which installs a copy into a throwaway repo
# and proves each refusal happens for its OWN stated reason, plus verify.sh
# check 8b, which replays the two scanner invocations below against the pinned
# probe fixture.
#
# FOUR RULES, CHEAPEST FIRST. Each refusal names its rule, because an exit code
# alone cannot say WHICH guard refused, and a hook that refuses for the wrong
# reason passes a lazy test while blind to the case it claims to cover.
#   1. Private PATHS never ship, whatever they contain.
#   2. Credential-shaped CONTENT never ships (hooks/secret-scan.sh, rule set 1).
#   3. Private-network / internal-infra CONTENT never ships (same scanner,
#      --infra rule set).
#   4. Terms from the owner's local deny-list never ship.
#
# NO PATTERN TEXT LIVES HERE. Both rule sets belong to hooks/secret-scan.sh and
# its two rule files; this hook executes the scanner, so there is no copy to
# drift. The one local exception is LOCAL_ONLY below, and the comment on it
# says why it cannot move.
#
# EVERYTHING FAILS CLOSED. A git diff that errors, a scanner that is missing,
# not executable, or exiting outside {0 match, 1 clean}: each refuses the
# commit and says the scan DID NOT RUN. An unrun scan and a clean scan must
# never look alike; that principle is load-bearing across this whole repo.

# Rule-1 paths: added or modified under any of these means refusal. Deletions
# are allowed, so cleaning up a mistake is never itself blocked.
PRIVATE_PATHS=(
  "memory/facts/"
  # The memory INDEX is gitignored, and .gitignore is not a guard: `git add -f`
  # ignores it, and a file tracked from before it was ignored stages with no
  # flag at all. The index names every fact the owner asked to be remembered,
  # so it carries a path rule of its own. The tracked template beside it,
  # memory/MEMORY.example.md, must stay committable, which the test asserts.
  "memory/MEMORY.md"
  "memory/compile-manifest.json"
  "brainstorms/"
  "plans/"
  "proposals/"
  "settings.json"
  "settings.local.json"
  "history.jsonl"
  "projects/"
  "sessions/"
  "cache/"
  "paste-cache/"
)

# Word-next-to-value shapes and machine-user paths. These CANNOT move into the
# shared rule files: the bare word forms match the pinned clean fixture's own
# example-config line (turning the negative control red), and the /Users/ rule
# would flag ordinary documentation paths in the public tracked-content scan.
# They are safe here only because this hook reads the staged DIFF, where the
# exclusion list below supplies the context those rules lack.
LOCAL_ONLY="/Users/[a-zA-Z0-9_-]+|session: [a-f0-9-]{36}|password\s*[:=]|secret\s*[:=]|api[_-]?key\s*[:=]"

refuse() {  # $1 headline, remaining args extra lines
  echo "❌ BLOCKED: $1"
  shift
  for line in "$@"; do echo "   $line"; done
  exit 1
}

WORK="$(mktemp -d)"
trap 'rm -rf "$WORK"' EXIT

echo "🔍 no-yolo pre-commit: scanning for personal data..."

# --- Rule 1: private paths --------------------------------------------------
STAGED=$(git diff --cached --name-status | grep -E '^[AM]' | awk '{print $2}')
for p in "${PRIVATE_PATHS[@]}"; do
  if printf '%s\n' "$STAGED" | grep -q "^$p"; then
    refuse "personal path being added/modified: $p" "Run: git reset HEAD <file> to unstage"
  fi
done

# --- The three diff slices ---------------------------------------------------
# Each diff is written to a file and its exit status checked on the spot. The
# inline `$(git diff | grep)` form once hid a fail-open: a diff that errored
# left the variable empty and every scan below found nothing, printing "clean"
# while blind. And `set -o pipefail` is not the fix, because grep exiting 1 is
# the NORMAL result on most commits.
#
# Slice A (deny-list): everything staged.
# Slice B (infra scan): minus the two pinned probe fixtures, whose entire
#   purpose is to hold values the scan must catch, and minus the infra rule
#   file, which matches its own rules. The fixtures are sha256-pinned by
#   verify.sh, so excluding them hides nothing.
# Slice C (credential scan): B's exclusions plus every file that legitimately
#   documents credential shapes: this hook, verify.sh, the deny-list template,
#   and both rule files. This list mirrors verify.sh's SCAN_EXCLUDE; change one,
#   change the other.
added_lines() {  # $1 diff file -> the + lines, minus headers and regex-carrying lines
  grep -E '^\+' "$1" | grep -vE '^\+\+\+' | grep -v '\[a-zA-Z' | grep -v '\[a-z0-9'
}

git diff --cached > "$WORK/a.diff" \
  || refuse "git diff failed — the scan did not run (fail closed)"
ALL_ADDED=$(added_lines "$WORK/a.diff")

git diff --cached -- . ":!hooks/tests/infra-scan-probe.txt" ":!hooks/tests/infra-scan-clean.txt" \
  ":!hooks/infra-patterns.txt" > "$WORK/b.diff" \
  || refuse "git diff failed — the scan did not run (fail closed)"
INFRA_ADDED=$(added_lines "$WORK/b.diff")

git diff --cached -- . ":!hooks/pre-commit" ":!verify.sh" \
  ":!.no-yolo-deny.example.txt" ":!hooks/secret-patterns.txt" ":!hooks/infra-patterns.txt" \
  ":!hooks/tests/infra-scan-probe.txt" ":!hooks/tests/infra-scan-clean.txt" > "$WORK/c.diff" \
  || refuse "git diff failed — the scan did not run (fail closed)"
CRED_ADDED=$(added_lines "$WORK/c.diff")

# --- Rules 2 and 3: the shared scanner ---------------------------------------
# Resolved from the repo root at run time, because this hook executes as a COPY
# in .git/hooks, outside the tree.
SCANNER="$(git rev-parse --show-toplevel)/hooks/secret-scan.sh"
[ -x "$SCANNER" ] || refuse "hooks/secret-scan.sh missing or not executable — the leak scans cannot run (fail closed)"

# The scan that runs is the WORKING-TREE scanner and rules. If any of the three
# has unstaged changes, the version being tested is not the version being
# committed, and approving one on the other's behaviour is meaningless.
if ! git diff --quiet -- hooks/secret-scan.sh hooks/secret-patterns.txt hooks/infra-patterns.txt 2>/dev/null; then
  refuse "hooks/secret-scan.sh or one of its rule files has unstaged changes." \
         "The scan that just ran is not the scan being committed. Stage them, then commit."
fi

CRED_HITS=$(printf '%s\n' "$CRED_ADDED" | "$SCANNER")
rc=$?
if [ "$rc" -ne 0 ] && [ "$rc" -ne 1 ]; then
  refuse "secret-scan.sh exited $rc — the credential scan could not run (fail closed)." \
         "Check hooks/secret-patterns.txt is present and every rule compiles."
fi
LOCAL_HITS=$(printf '%s\n' "$CRED_ADDED" | grep -E "$LOCAL_ONLY")
if [ -n "$CRED_HITS" ] || [ -n "$LOCAL_HITS" ]; then
  echo "❌ BLOCKED: personal data pattern found in diff:"
  [ -n "$CRED_HITS" ] && echo "$CRED_HITS"
  [ -n "$LOCAL_HITS" ] && echo "$LOCAL_HITS"
  echo ""
  echo "Fix the content above, then re-stage and commit."
  exit 1
fi

INFRA_HITS=$(printf '%s\n' "$INFRA_ADDED" | "$SCANNER" --infra)
rc=$?
if [ "$rc" -ne 0 ] && [ "$rc" -ne 1 ]; then
  refuse "secret-scan.sh --infra exited $rc — the private-network scan could not run (fail closed)." \
         "Check hooks/infra-patterns.txt is present and every rule compiles."
fi
if [ -n "$INFRA_HITS" ]; then
  echo "❌ BLOCKED: private network / internal infra value in diff:"
  echo "$INFRA_HITS"
  echo ""
  echo "Docs must use placeholders (<your-host>, <port>) — never real LAN IPs,"
  echo "tailnet addresses, or internal hostnames. Fix, re-stage, commit."
  exit 1
fi

# --- Rule 4: the owner's local deny-list -------------------------------------
DENY="$(git rev-parse --show-toplevel)/.no-yolo-deny.txt"
if [ -f "$DENY" ]; then
  TERMS=$(grep -vE '^\s*#|^\s*$' "$DENY" | paste -sd'|' -)
  if [ -n "$TERMS" ]; then
    DENIED=$(printf '%s\n' "$ALL_ADDED" | grep -iE "$TERMS")
    if [ -n "$DENIED" ]; then
      echo "❌ BLOCKED: term from .no-yolo-deny.txt (company/private) in diff:"
      echo "$DENIED"
      echo ""
      echo "These must never be published. Fix, re-stage, commit."
      echo "(Edit ~/.claude/.no-yolo-deny.txt to adjust the list.)"
      exit 1
    fi
  fi
fi

echo "✅ no-yolo pre-commit: clean"
exit 0
