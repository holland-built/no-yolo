#!/usr/bin/env bash
# Pre-commit hook for ~/.claude (holland-built/no-yolo) — TRACKED SOURCE.
# Installed into .git/hooks/pre-commit by setup.sh. Blocks commits containing
# personal data, private-network/infra values, and terms from .no-yolo-deny.txt.

# Credential / personal patterns — the five that CANNOT be shared.
# Every vendor credential FORMAT rule now lives in hooks/secret-patterns.txt, and every
# private-network / internal-infra rule in hooks/infra-patterns.txt. Both are applied by
# one executable, hooks/secret-scan.sh (step 2 and step 3 below), which every consumer
# calls — this hook and verify.sh. Two rule files, one reader, one
# regex engine, and NO pattern text left in this hook at all: there is nothing to keep in
# sync by hand and nothing for verify.sh check 8b to parse back out.
# These five stay local because a shared scan cannot carry them:
#   - the unguarded WORD forms (password=, secret:, api_key=) match the pinned CLEAN
#     fixture's own line `example config: api_key = <your-key-here>`
#     (hooks/tests/infra-scan-clean.txt), and that fixture must stay clean;
#   - /Users/… would flag ordinary documentation paths in the public tracked-content scan.
# Both are safe here only because this runs against the staged diff, where the
# excluded-file list below supplies the context those rules lack.
LOCAL_PATTERNS="/Users/[a-zA-Z0-9_-]+|session: [a-f0-9-]{36}|password\s*[:=]|secret\s*[:=]|api[_-]?key\s*[:=]"

BLOCKED_FILES=(
  "memory/facts/"
  # The index names every fact, so publishing it publishes the list of what the
  # owner asked to be remembered even though the fact bodies stay behind. It is
  # gitignored, and .gitignore stops an ordinary `git add` and nothing else, so a
  # `git add -f` or an already-tracked history would walk straight past it. The
  # tracked template is memory/MEMORY.example.md.
  "memory/MEMORY.md"
  "memory/compile-manifest.json"
  "brainstorms/"
  "plans/"
  "proposals/"
  "settings.json"
  "settings.local.json"
  "history.jsonl"
  "projects/"
  "sessions/"
  "cache/"
  "paste-cache/"
)

T="$(mktemp -d)"
trap 'rm -rf "$T"' EXIT

echo "🔍 no-yolo pre-commit: scanning for personal data..."

# 1 — Block personal dirs (only additions/modifications — allow deletions)
STAGED_AM=$(git diff --cached --name-status | grep -E "^[AM]" | awk '{print $2}')
for pattern in "${BLOCKED_FILES[@]}"; do
  if echo "$STAGED_AM" | grep -q "^$pattern"; then
    echo "❌ BLOCKED: personal path being added/modified: $pattern"
    echo "   Run: git reset HEAD <file> to unstage"
    exit 1
  fi
done

# The two probe fixtures are excluded from the infra scan below, by name, because
# their whole purpose is to hold the values it blocks: they are the controls
# that prove this pattern can still match (verify.sh checks 8a/8b). Without this
# exclusion the hook refuses every commit that touches them — it did, which is how
# they came to be separate files instead of inline test data.
#
# They are the ONE place in this repo a real leak could hide, so verify.sh pins both
# by sha256 and fails if either changes without the hash being updated. Keep this
# list and verify.sh's SCAN_EXCLUDE in step.
# Each diff is produced ONCE, into a file, and its exit status checked immediately.
# Inline `$(git diff ... | grep ...)` hid a fail-open: a git diff that failed left the
# variable empty, every scan below found nothing, and the hook printed "clean" while
# blind. `set -o pipefail` is NOT the fix — grep exiting 1 is normal in these pipelines
# and would abort step 1 on every ordinary commit.
# added lines only, minus lines that are themselves regex patterns
git diff --cached > "$T/all.diff" || { echo "❌ BLOCKED: git diff failed — the scan did not run (fail closed)"; exit 1; }
ADDED=$(grep -E "^\+" "$T/all.diff" | grep -vE "^\+\+\+" | grep -v "\[a-zA-Z" | grep -v "\[a-z0-9")

# The same, with the probe fixtures' hunks removed, for the infra scan only. Done
# per-file via --cached -- :!path so a probe line cannot be attributed to another
# file's diff. hooks/infra-patterns.txt is excluded for the same reason
# hooks/secret-patterns.txt is excluded below: a file of infra regexes matches its own
# rules. Its compensating control is secret-scan.sh, which lints that file's comments
# against its own patterns and refuses to run on a hit.
git diff --cached -- . ":!hooks/tests/infra-scan-probe.txt" ":!hooks/tests/infra-scan-clean.txt" \
  ":!hooks/infra-patterns.txt" \
  > "$T/noprobe.diff" || { echo "❌ BLOCKED: git diff failed — the scan did not run (fail closed)"; exit 1; }
ADDED_NOPROBE=$(grep -E "^\+" "$T/noprobe.diff" | grep -vE "^\+\+\+" | grep -v "\[a-zA-Z" | grep -v "\[a-z0-9")

# The same again, minus every file that legitimately CONTAINS credential formats:
# the two pinned probe fixtures, plus the five files that document the patterns
# themselves (this hook, verify.sh, the deny-list example, and the two rule files —
# a file of regexes matches its own rules on every line; their compensating control
# is secret-scan.sh, which lints whichever file it loads against that file's own
# patterns and refuses to run on a hit).
# This list mirrors verify.sh's SCAN_EXCLUDE — change one, change the other.
# The fixtures are sha256-pinned by verify.sh, so excluding them hides nothing.
# ":!skills/health/SKILL.md" was a sixth entry here until 2026-08-21. The rebuild
# deleted that skill, so the pathspec matched nothing and excluded nothing; it was
# removed from this list and from verify.sh's in the same edit.
git diff --cached -- . ":!hooks/pre-commit" ":!verify.sh" \
  ":!.no-yolo-deny.example.txt" ":!hooks/secret-patterns.txt" ":!hooks/infra-patterns.txt" \
  ":!hooks/tests/infra-scan-probe.txt" ":!hooks/tests/infra-scan-clean.txt" \
  > "$T/cred.diff" || { echo "❌ BLOCKED: git diff failed — the scan did not run (fail closed)"; exit 1; }
ADDED_CRED=$(grep -E "^\+" "$T/cred.diff" | grep -vE "^\+\+\+" | grep -v "\[a-zA-Z" | grep -v "\[a-z0-9")

# 2 — Block personal / credential content
# This hook runs as a COPY in .git/hooks, outside the repo tree, so the scanner has to
# be resolved from the repo root at runtime — the same idiom the deny-list uses below.
SCAN="$(git rev-parse --show-toplevel)/hooks/secret-scan.sh"
[ -x "$SCAN" ] || { echo "❌ BLOCKED: hooks/secret-scan.sh missing or not executable — the leak scans cannot run (fail closed)"; exit 1; }

# The scan that runs is the WORKING-TREE scanner and rule files, not the versions
# being committed. An unstaged edit to any of them would approve a different staged
# implementation than the one that was tested.
if ! git diff --quiet -- hooks/secret-scan.sh hooks/secret-patterns.txt hooks/infra-patterns.txt 2>/dev/null; then
  echo "❌ BLOCKED: hooks/secret-scan.sh or one of its rule files has unstaged changes."
  echo "   The scan that just ran is not the scan being committed. Stage them, then commit."
  exit 1
fi

MATCHES=$(printf '%s\n' "$ADDED_CRED" | "$SCAN")
rc=$?
# Only 0 (match) and 1 (no match) are outcomes. Anything else means the scan could not run.
if [ "$rc" -ne 0 ] && [ "$rc" -ne 1 ]; then
  echo "❌ BLOCKED: secret-scan.sh exited $rc — the credential scan could not run (fail closed)."
  echo "   Check hooks/secret-patterns.txt is present and every rule compiles."
  exit 1
fi

LOCAL_MATCHES=$(printf '%s\n' "$ADDED_CRED" | grep -E "$LOCAL_PATTERNS")
if [ -n "$MATCHES" ] || [ -n "$LOCAL_MATCHES" ]; then
  echo "❌ BLOCKED: personal data pattern found in diff:"
  [ -n "$MATCHES" ] && echo "$MATCHES"
  [ -n "$LOCAL_MATCHES" ] && echo "$LOCAL_MATCHES"
  echo ""
  echo "Fix the content above, then re-stage and commit."
  exit 1
fi

# 3 — Block private-network / internal-infra values (use placeholders in docs).
# These leaked once (a self-hosted LAN IP, a tailnet host) and the credential rules
# above did not catch them. Same executable as step 2, second rule file:
# hooks/infra-patterns.txt. Same status allowlist too — only 0 (match) and 1 (no match)
# are outcomes, and anything else means the scan could not run.
INFRA=$(printf '%s\n' "$ADDED_NOPROBE" | "$SCAN" --infra)
rc=$?
if [ "$rc" -ne 0 ] && [ "$rc" -ne 1 ]; then
  echo "❌ BLOCKED: secret-scan.sh --infra exited $rc — the private-network scan could not run (fail closed)."
  echo "   Check hooks/infra-patterns.txt is present and every rule compiles."
  exit 1
fi

if [ -n "$INFRA" ]; then
  echo "❌ BLOCKED: private network / internal infra value in diff:"
  echo "$INFRA"
  echo ""
  echo "Docs must use placeholders (<your-host>, <port>) — never real LAN IPs,"
  echo "tailnet addresses, or internal hostnames. Fix, re-stage, commit."
  exit 1
fi

# 4 — Block company / private terms from the local (gitignored) deny-list
DENY_FILE="$(git rev-parse --show-toplevel)/.no-yolo-deny.txt"
if [ -f "$DENY_FILE" ]; then
  TERMS=$(grep -vE '^\s*#|^\s*$' "$DENY_FILE" | paste -sd'|' -)
  if [ -n "$TERMS" ]; then
    DENIED=$(echo "$ADDED" | grep -iE "$TERMS")
    if [ -n "$DENIED" ]; then
      echo "❌ BLOCKED: term from .no-yolo-deny.txt (company/private) in diff:"
      echo "$DENIED"
      echo ""
      echo "These must never be published. Fix, re-stage, commit."
      echo "(Edit ~/.claude/.no-yolo-deny.txt to adjust the list.)"
      exit 1
    fi
  fi
fi

echo "✅ no-yolo pre-commit: clean"
exit 0
